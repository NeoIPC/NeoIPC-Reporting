# Environment for the local `docker compose` stack.
#
#     cp .env.sample .env
#
# `.gitignore` ignores `*.env`, so your `.env` stays local while this sample is
# committed. Every variable without a default below is REQUIRED: compose
# substitutes an unset variable with an empty string, which fails late and
# confusingly (an image tag of `postgis/postgis:` rather than a clear error).
#
# The passwords here are placeholders for a throwaway local stack. Replace them
# before running this anywhere another person can reach.

# --- Image versions ---------------------------------------------------------

# Database image.
POSTGIS_VERSION=14-3.5-alpine

# DHIS2 image. Pick a version neoipcr supports — `neoipcr_supported_versions()`
# returns the current list, and reading a server outside it emits a warning.
DHIS2_VERSION=2.40.12.0

# Ingress image.
TRAEFIK_VERSION=v3.7.9

# --- Database ---------------------------------------------------------------

# Database created by the postgis image on first start.
POSTGRES_DB=dhis2

# Superuser password, used to initialise the cluster and to run `init-scripts/`.
POSTGRES_PASSWORD=change-me-postgres

# DHIS2's own database role. `init-scripts/02-create-database-user.sh` creates
# it and grants it the database; `config/dhis2/dhis.conf` connects as it.
POSTGRES_DB_USERNAME=dhis
POSTGRES_DB_PASSWORD=change-me-dhis

# --- Ingress ----------------------------------------------------------------

# Host port for Traefik's web entrypoint; the stack is then reachable at
# http://localhost:<this>. Optional — compose defaults it to 8080.
TRAEFIK_PORT=8080
