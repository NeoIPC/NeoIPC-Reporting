<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.14.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- For the source-generator drift tests in Category=Generator. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <!-- For the container smoke tests in Category=Container. -->
    <PackageReference Include="Testcontainers" Version="4.15.0" />
    <!-- For reading a rendered PDF's font dictionaries (PdfFontEmbedding). -->
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- ASP.NET types (WebApplication + endpoint metadata) for the in-process
       EndpointAuthorizationTests; the test SDK is the plain Microsoft.NET.Sdk,
       so the shared framework must be referenced explicitly. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NeoIPC.Reporting\NeoIPC.Reporting.csproj" />
    <!-- Reference the generator project as a regular library (not OutputItemType=Analyzer)
         so we can construct ParameterRecordGenerator directly in tests. -->
    <ProjectReference Include="..\..\src\NeoIPC.Reporting.Generators\NeoIPC.Reporting.Generators.csproj" />
  </ItemGroup>

</Project>
