<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..</DockerfileContext>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.5.2" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!-- Not used directly. Microsoft.AspNetCore.OpenApi 10.0.10 resolves
         Microsoft.OpenApi to 2.0.0, which carries GHSA-v5pm-xwqc-g5wc (stack
         overflow on a circular schema reference while parsing an OpenAPI
         document); 2.7.5 is the first patched 2.x. This reference raises the
         transitive floor past it. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NeoIPC.Reporting.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NeoIPC.Reporting.Generators\NeoIPC.Reporting.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Committed JSON snapshots of the upstream Surveillance-Toolkit report
       params: blocks. The source generator (NeoIPC.Reporting.Generators)
       reads these via Roslyn's AdditionalTexts API and emits the
       *RenderParameters records. Regenerate the snapshots from the
       upstream report sources after the upstream params change. -->
  <ItemGroup>
    <AdditionalFiles Include="Schemas\Partner-Report.qmd-schema.json" />
    <AdditionalFiles Include="Schemas\Reference-Report.qmd-schema.json" />
  </ItemGroup>

  <!-- <AdditionalFiles Include="..."> does not fail when a path is missing;
       the source generator would silently produce zero records and the
       build would then fail with a less obvious NRP001 from each downstream
       [RenderParameter] property. Surface the real cause up-front. -->
  <Target Name="EnsureReportSchemas" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)Schemas\Partner-Report.qmd-schema.json')"
           Text="Missing Schemas\Partner-Report.qmd-schema.json. Regenerate the committed report-schema snapshots from the upstream report sources." />
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)Schemas\Reference-Report.qmd-schema.json')"
           Text="Missing Schemas\Reference-Report.qmd-schema.json. Regenerate the committed report-schema snapshots from the upstream report sources." />
  </Target>

  <ItemGroup>
    <Content Include="scripts\**\*.R">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
