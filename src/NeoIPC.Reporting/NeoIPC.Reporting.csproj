<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..</DockerfileContext>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.3.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0-rc.1.25451.107" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0-preview.4" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NeoIPC.Reporting.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NeoIPC.Reporting.Generators\NeoIPC.Reporting.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Committed JSON snapshots of the upstream Surveillance-Toolkit report
       params: blocks. The source generator (NeoIPC.Reporting.Generators)
       reads these via Roslyn's AdditionalTexts API and emits the
       *RenderParameters records. Regenerate with
       tools/Generate-ReportSchemas.ps1 (in the workspace) after the
       upstream params change. -->
  <ItemGroup>
    <AdditionalFiles Include="Schemas\Partner-Report.qmd-schema.json" />
    <AdditionalFiles Include="Schemas\Reference-Report.qmd-schema.json" />
  </ItemGroup>

  <!-- <AdditionalFiles Include="..."> does not fail when a path is missing;
       the source generator would silently produce zero records and the
       build would then fail with a less obvious NRP001 from each downstream
       [RenderParameter] property. Surface the real cause up-front. -->
  <Target Name="EnsureReportSchemas" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)Schemas\Partner-Report.qmd-schema.json')"
           Text="Missing Schemas\Partner-Report.qmd-schema.json. From the workspace root, run: pwsh tools\Generate-ReportSchemas.ps1" />
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)Schemas\Reference-Report.qmd-schema.json')"
           Text="Missing Schemas\Reference-Report.qmd-schema.json. From the workspace root, run: pwsh tools\Generate-ReportSchemas.ps1" />
  </Target>

  <ItemGroup>
    <Content Include="scripts\**\*.R">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
